{
  "name": "ado-dash",
  "version": "0.1.0",
  "packageManager": "bun@1.3.10",
  "description": "A terminal dashboard for Azure DevOps pull requests and work items.",
  "type": "module",
  "bin": {
    "ado-dash": "./dist/main.js"
  },
  "scripts": {
    "dev": "bun run src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "bun run dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test"
  },
  "engines": {
    "node": ">=20",
    "bun": ">=1.3.0"
  },
  "dependencies": {
    "@opentui/core": "^0.3.1",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
